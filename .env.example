# Copy to .env.local for local development. Never commit real values.
# All variables are optional for the demo build; defaults are shown.

# Public base URL, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://clerk.adbyrd.com

# Optional demo gate. When set, /demo/* requires ?key=<value> once,
# after which a 30-day HttpOnly cookie is issued. Leave empty to keep demos open
# (they are always noindex and never linked from the public site).
DEMO_ACCESS_KEY=

# Sales contact shown on demo pages and the landing page.
NEXT_PUBLIC_SALES_EMAIL=support@adbyrd.com
NEXT_PUBLIC_SALES_PHONE=+1 (888) 712-1694
